SYSTUTOR_APP_NAME=SYSTUTOR OSS API
SYSTUTOR_ENV=local
SYSTUTOR_DEBUG=true
SYSTUTOR_VERSION=0.1.0
SYSTUTOR_API_PREFIX=/api/v1
SYSTUTOR_LOG_LEVEL=INFO
SYSTUTOR_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/systutor
SYSTUTOR_REDIS_URL=redis://localhost:6379/0
SYSTUTOR_OUTBOX_DISPATCH_BATCH_SIZE=100
SYSTUTOR_OUTBOX_MAX_RETRIES=3
SYSTUTOR_JWT_SECRET_KEY=change-me-in-local-env
SYSTUTOR_JWT_ACCESS_TOKEN_TTL_MINUTES=60
SYSTUTOR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SYSTUTOR_USE_TRANSACTIONAL_STOCK_BRIDGE=true
SYSTUTOR_ALLOW_LEGACY_STOCK_FALLBACK=false
SYSTUTOR_ALLOW_CYLINDER_PRODUCT_FALLBACK=true
SYSTUTOR_ALLOW_SEED_ORPHAN_REPAIR_FALLBACK=false
SYSTUTOR_LOGISTICS_ROUTING_ENABLED=true
SYSTUTOR_LOGISTICS_OSRM_BASE_URL=http://100.67.5.50:5000
SYSTUTOR_LOGISTICS_VROOM_BASE_URL=http://100.67.5.50:3000
SYSTUTOR_LOGISTICS_ROUTING_REQUEST_TIMEOUT_SECONDS=10
SYSTUTOR_LOGISTICS_ROUTING_CACHE_TTL_SECONDS=300
SYSTUTOR_LOGISTICS_WAYBILL_ISSUER_LEGAL_NAME=Transportes Demo SL
SYSTUTOR_LOGISTICS_WAYBILL_ISSUER_ADDRESS_LINE=Calle Ruta 100
SYSTUTOR_LOGISTICS_WAYBILL_ISSUER_POSTAL_CITY_LINE=47001 Valladolid

SYSTUTOR_SEED_TENANT_NAME=Demo Tenant
SYSTUTOR_SEED_TENANT_SLUG=demo
SYSTUTOR_SEED_BRANCH_NAME=Main Branch
SYSTUTOR_SEED_BRANCH_CODE=MAIN
SYSTUTOR_SEED_ADMIN_EMAIL=admin@example.com
SYSTUTOR_SEED_ADMIN_PASSWORD=ChangeMe123!
SYSTUTOR_SEED_ADMIN_FULL_NAME=System Admin
