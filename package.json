{
  "name": "systutor-oss",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "postgres": "python3 tools/dev/local_services.py postgres",
    "backend": "python3 tools/dev/local_services.py backend",
    "backend:no-reload": "python3 tools/dev/local_services.py backend-no-reload",
    "services": "python3 tools/dev/local_services.py services",
    "services:no-reload": "python3 tools/dev/local_services.py backend-no-reload",
    "psql": "python3 tools/dev/local_services.py psql",
    "services:stop": "python3 tools/dev/local_services.py stop",
    "status:services": "python3 tools/dev/local_services.py status",
    "frontend:stop": "python3 tools/dev/stop_frontend.py",
    "migrate": ".venv/bin/python -m alembic -c apps/api/alembic.ini upgrade head",
    "migrate:check": ".venv/bin/python -m alembic -c apps/api/alembic.ini check",
    "migrate:history": ".venv/bin/python -m alembic -c apps/api/alembic.ini history",
    "migrate:downgrade": ".venv/bin/python -m alembic -c apps/api/alembic.ini downgrade -1",
    "migrate:plugins": ".venv/bin/python -m apps.api.app.commands.migrate_plugins",
    "migrate:plugin": ".venv/bin/python -m apps.api.app.commands.migrate_plugins",
    "frontend": "node /data/data/com.termux/files/usr/lib/node_modules/pnpm/bin/pnpm.cjs --filter @systutor/web dev",
    "dev:web": "node /data/data/com.termux/files/usr/lib/node_modules/pnpm/bin/pnpm.cjs --filter @systutor/web dev",
    "build": "node /data/data/com.termux/files/usr/lib/node_modules/pnpm/bin/pnpm.cjs --filter @systutor/web build",
    "build:web": "node /data/data/com.termux/files/usr/lib/node_modules/pnpm/bin/pnpm.cjs --filter @systutor/web build",
    "frontend-build": "node /data/data/com.termux/files/usr/lib/node_modules/pnpm/bin/pnpm.cjs --filter @systutor/web build",
    "frontend:prod": "node /data/data/com.termux/files/usr/lib/node_modules/pnpm/bin/pnpm.cjs --filter @systutor/web build && node /data/data/com.termux/files/usr/lib/node_modules/pnpm/bin/pnpm.cjs --filter @systutor/web preview",
    "lint:web": "echo \"frontend lint no configurado todavia\"",
    "test:web": "node /data/data/com.termux/files/usr/lib/node_modules/pnpm/bin/pnpm.cjs --filter @systutor/web test"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3"
  },
  "pnpm": {}
}
