{
  "name": "systutor-oss",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "postgres": "python3 tools/dev/local_services.py postgres",
    "backend": "python3 tools/dev/local_services.py backend",
    "services": "python3 tools/dev/local_services.py services",
    "psql": "python3 tools/dev/local_services.py psql",
    "status:services": "python3 tools/dev/local_services.py status",
    "migrate": ".venv/bin/python -m alembic -c apps/api/alembic.ini upgrade head",
    "migrate:check": ".venv/bin/python -m alembic -c apps/api/alembic.ini check",
    "migrate:history": ".venv/bin/python -m alembic -c apps/api/alembic.ini history",
    "migrate:downgrade": ".venv/bin/python -m alembic -c apps/api/alembic.ini downgrade -1",
    "frontend": "node /data/data/com.termux/files/usr/lib/node_modules/pnpm/bin/pnpm.cjs --filter @systutor/web dev",
    "dev:web": "pnpm --filter @systutor/web dev",
    "build": "pnpm --filter @systutor/web build",
    "build:web": "pnpm --filter @systutor/web build",
    "lint:web": "echo \"frontend lint no configurado todavia\"",
    "test:web": "echo \"frontend testing manual en esta fase\""
  }
}
