{
  "id": "ventas",
  "name": "Ventas",
  "version": "0.1.0",
  "api_version": "1",
  "requires": [
    "crm",
    "productos"
  ],
  "backend_entrypoint": "cotizacion.backend.plugin:register",
  "frontend_entrypoint": "cotizacion/frontend/register.ts",
  "permissions": [
    "ventas.cotizacion.create",
    "ventas.cotizacion.read",
    "ventas.cotizacion.read_all",
    "ventas.cotizacion.confirm"
  ],
  "events": [
    "ventas.cotizacion.created",
    "ventas.cotizacion.confirmed"
  ],
  "description": "Plugin de ventas con cotizaciones via consola DSL y formulario visual. Flujo: cotizacion → planificacion → jornadas."
}
